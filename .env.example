# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neo ID Authentication (Optional)
NEXT_PUBLIC_NEOID_CLIENT_ID=your_neo_id_client_id
NEXT_PUBLIC_NEOID_ISSUER=https://id.neome.uk

# Vercel Blob Storage (Optional)
NEXT_PUBLIC_VERCEL_BLOB_API_URL=https://blob.vercel-storage.com
NEXT_PUBLIC_VERCEL_BLOB_API_VERSION_OVERRIDE=
NEXT_PUBLIC_VERCEL_BLOB_PROXY_THROUGH_ALTERNATIVE_API=false

# Debug Settings
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_SHOW_HITBOXES=false

# Vercel Deployment (Auto-injected)
NEXT_PUBLIC_VERCEL_DEPLOYMENT_ID=
