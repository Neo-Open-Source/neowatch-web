---
import { text } from "../../lib/text";

interface Props {
  info: [string, string][];
  names: { alternatives: string[] };
}

const { info, names } = Astro.props;
---

<div class="mt-3 overflow-hidden rounded-md bg-elevated shadow-card">
  <dl>
    {
      info.map(([label, value], index) => (
        <div
          class={`flex items-start justify-between gap-3 px-3 py-2 ${
            index > 0 ? "border-t border-line/60" : ""
          }`}
        >
          <dt class="shrink-0 text-ui text-faint">{label}</dt>
          <dd class="min-w-0 text-right text-ui font-medium text-ink">{value}</dd>
        </div>
      ))
    }
  </dl>
</div>

<div class="mt-2 flex flex-col gap-1 px-1">
  <span class="text-meta text-faint">{text.detail.altNames}</span>
  <div class="flex items-center gap-2">
    <span class="min-w-0 flex-1 truncate text-ui font-medium text-ink">{names.alternatives[0]}</span>
    <button
      class="shrink-0 text-ui text-faint transition-colors hover:text-ink"
      type="button"
      data-names-button
    >
      {text.detail.moreNames}
    </button>
  </div>
</div>
