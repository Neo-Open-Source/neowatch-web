---
import { Icon } from "astro-icon/components";

interface Props {
  id: string;
  label: string;
  max?: number | undefined;
  value?: number;
}

const { id, label, max, value = 0 } = Astro.props;
---

<div>
  <label class="mb-1.5 block text-meta text-faint" for={id}>{label}</label>
  <div
    class="flex h-10 items-stretch overflow-hidden rounded-sm border border-line bg-field transition-colors focus-within:border-line-strong"
    data-stepper
  >
    <input
      id={id}
      class="w-full min-w-0 appearance-none border-0 bg-transparent px-3 text-ui text-ink outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
      type="number"
      min="0"
      max={max}
      value={String(value)}
    />
    <div class="flex w-8 shrink-0 flex-col border-l border-line">
      <button
        class="flex flex-1 items-center justify-center text-muted transition-colors hover:bg-surface-hover hover:text-ink active:bg-line"
        type="button"
        data-step-up
        aria-label={`${label} плюс`}
      >
        <Icon name="solar:alt-arrow-up-bold" width="13" height="13" />
      </button>
      <button
        class="flex flex-1 items-center justify-center border-t border-line text-muted transition-colors hover:bg-surface-hover hover:text-ink active:bg-line"
        type="button"
        data-step-down
        aria-label={`${label} минус`}
      >
        <Icon name="solar:alt-arrow-down-bold" width="13" height="13" />
      </button>
    </div>
  </div>
</div>
