---
import RankBadge from "./RankBadge.astro";
import RatingBadge from "./RatingBadge.astro";

interface Props {
  rank?: number | undefined;
  rating?: number | undefined;
}

const { rank, rating } = Astro.props;
---

<li class="min-w-0">
  <div class="relative aspect-[5/7] overflow-hidden rounded-poster bg-skeleton">
    <span class="absolute top-1.5 left-1.5 flex items-center gap-1">
      {
        rating !== undefined ? (
          <RatingBadge rating={rating} />
        ) : (
          <span class="h-[24px] w-[50px] animate-pulse rounded-sm bg-skeleton-strong" />
        )
      }
      {rank !== undefined && rank <= 3 && <RankBadge rank={rank} />}
    </span>
  </div>
  <div class="mt-2 h-3 w-4/5 animate-pulse rounded-sm bg-skeleton-strong" />
  <div class="mt-1.5 h-2.5 w-1/2 animate-pulse rounded-sm bg-skeleton-strong" />
</li>
