---
import { Icon } from "astro-icon/components";
import type { CollectionSummary } from "../data/types";

interface Props {
  collection: CollectionSummary | null;
}

const { collection } = Astro.props;
---

{
  collection ? (
    <a
      class="flex flex-col overflow-hidden rounded-md bg-bg px-4 pt-4 pb-3 transition-colors hover:bg-surface-hover"
      href={`/collections/${collection.slug}`}
    >
      <span class="line-clamp-2 min-h-[40px] text-center text-subtitle leading-[1.3] font-semibold">
        {collection.title}
      </span>
      <span class="mx-auto mt-2 inline-flex items-center gap-1.5 rounded-sm bg-field px-2 py-0.5 text-caption text-muted">
        <Icon name="solar:layers-bold" width="11" height="11" />
        {collection.total}
      </span>
      <span class="mt-3 flex h-[110px] items-end justify-center">
        {collection.covers.slice(0, 3).map((cover, index) => (
          <img
            class:list={[
              "h-24 w-16 rounded-sm border border-line bg-elevated object-cover shadow-small",
              index === 0 && "-mr-6 -rotate-6",
              index === 1 && "z-10",
              index === 2 && "-ml-6 rotate-6",
            ]}
            src={cover}
            alt=""
            width="64"
            height="96"
            loading="lazy"
          />
        ))}
      </span>
    </a>
  ) : (
    <div class="flex flex-col overflow-hidden rounded-md bg-bg px-4 pt-4 pb-3" aria-hidden="true">
      <span class="mx-auto h-4 w-4/5 animate-pulse rounded-sm bg-skeleton-strong" />
      <span class="mx-auto mt-2 h-3.5 w-1/3 animate-pulse rounded-sm bg-skeleton-strong" />
      <span class="mt-3 flex h-[110px] items-end justify-center">
        <span class="-mr-6 h-24 w-16 rotate-[-6deg] animate-pulse rounded-sm border border-line-strong bg-skeleton-strong" />
        <span class="z-10 h-24 w-16 animate-pulse rounded-sm border border-line-strong bg-skeleton-strong" />
        <span class="-ml-6 h-24 w-16 rotate-[6deg] animate-pulse rounded-sm border border-line-strong bg-skeleton-strong" />
      </span>
    </div>
  )
}
