---
import { Icon } from "astro-icon/components";
import { entryStatuses } from "../lib/entry-status";
import type { PosterItem } from "../lib/poster-item";
import { mediaUrl } from "../lib/media-url";
import { text } from "../lib/text";
import RankBadge from "./RankBadge.astro";
import RatingBadge from "./RatingBadge.astro";

interface Props {
  card: PosterItem;
  favorite?: boolean;
  showKind?: boolean;
  badge?: string | undefined;
  rank?: number | undefined;
}

const { card, favorite = false, showKind = false, badge, rank } = Astro.props;
const href = mediaUrl(card.key, card.titleEnglish, card.titleOriginal, card.title);
const meta = showKind
  ? `${text.kinds[card.kind]}${card.year ? ` · ${card.year}` : ""}`
  : card.year
    ? String(card.year)
    : "";
---

<li
  class="group/card relative min-w-0"
  data-key={card.key}
  data-kind={card.kind}
  data-title={card.title}
  data-english={card.titleEnglish ?? ""}
  data-original={card.titleOriginal ?? ""}
  data-poster={card.poster ?? ""}
  data-available={String(card.available)}
>
  <div class="relative overflow-hidden rounded-poster bg-skeleton">
    <a class="block" href={href}>
      {
        card.poster ? (
          <img
            class="aspect-[5/7] w-full object-cover transition-opacity group-hover/card:opacity-90"
            src={card.poster}
            alt=""
            width="200"
            height="280"
            loading="lazy"
            data-card-poster
          />
        ) : (
          <div class="aspect-[5/7] w-full" />
        )
      }

      {(card.rating > 0 || rank !== undefined) && (
        <span class="absolute top-1.5 left-1.5 flex items-center gap-1">
          {card.rating > 0 && <RatingBadge rating={card.rating} />}
          {rank !== undefined && <RankBadge rank={rank} />}
        </span>
      )}

      {badge && (
        <span class="absolute bottom-1.5 left-1.5 rounded-sm bg-black/65 px-1.5 py-0.5 text-caption font-medium text-white">
          {badge}
        </span>
      )}
    </a>

    <button
      class="absolute top-1.5 right-1.5 z-10 grid size-7 place-items-center rounded-sm bg-black/55 text-white transition-colors hover:bg-accent hover:text-on-accent aria-pressed:text-accent"
      type="button"
      data-favorite-button
      data-key={card.key}
      data-title={card.title}
      data-poster={card.poster ?? ""}
      data-subtitle={meta}
      aria-pressed={favorite ? "true" : "false"}
      aria-label={text.card.bookmark}
      title={text.card.bookmark}
    >
      <Icon name="solar:bookmark-bold" width="15" height="15" />
    </button>

    <button
      class="absolute top-10 right-1.5 z-10 grid size-7 place-items-center rounded-sm bg-black/55 text-white opacity-0 transition-opacity group-hover/card:opacity-100 focus-visible:opacity-100"
      type="button"
      data-entry-button
      aria-expanded="false"
      aria-label={text.card.addToList}
      title={text.card.addToList}
    >
      <Icon name="solar:add-bold" width="15" height="15" />
    </button>

    <div
      class="fixed inset-auto m-0 w-36 flex-col rounded-md border border-line bg-panel p-1 shadow-panel [&:popover-open]:flex"
      role="menu"
      aria-label={text.card.addToList}
      popover="manual"
      data-entry-menu
    >
      {
        entryStatuses.map((status) => (
          <button
            class="rounded-sm px-2 py-1.5 text-start text-meta text-muted transition-colors hover:bg-surface-hover hover:text-ink"
            type="button"
            role="menuitem"
            data-entry-status={status}
          >
            {text.entry[status]}
          </button>
        ))
      }
    </div>
  </div>

  <a
    class="mt-2 block text-ui leading-[1.3] font-medium text-ink transition-colors hover:text-accent-strong"
    href={href}
    data-card-title
  >
    <span class="line-clamp-2">{card.title}</span>
  </a>

  {meta && <p class="mt-0.5 truncate text-caption text-faint">{meta}</p>}
</li>
