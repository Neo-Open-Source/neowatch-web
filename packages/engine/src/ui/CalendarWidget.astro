---
import type { EpisodeItem } from "../data/types";
import { groupByDay } from "../lib/dates";
import { mediaUrl } from "../lib/media-url";
import DayStrip from "./DayStrip.astro";
import SkeletonList from "./SkeletonList.astro";

interface Props {
  episodes: EpisodeItem[] | null;
}

const { episodes } = Astro.props;
const days = groupByDay(episodes);
const strip = days.map((day) => ({
  key: day.date,
  weekday: day.weekday,
  day: day.day,
  month: day.day === "1" ? day.month : undefined,
  count: day.items.length,
}));
---

<div class="flex flex-col" data-calendar>
  {
    episodes ? (
      <>
        {days[0] && <p class="pb-2 text-caption font-semibold text-faint">{days[0].month}</p>}

        <div class="pb-3">
          <DayStrip days={strip} />
        </div>

        {days.map((day, index) => (
          <ul
            class="hidden flex-col data-[active=true]:flex"
            data-calendar-list={day.date}
            data-active={index === 0 ? "true" : undefined}
          >
            {day.items.map((episode) => (
              <li>
                <a
                  class="flex items-start gap-3 rounded-sm px-1 py-2 transition-colors hover:bg-surface-hover"
                  href={mediaUrl(episode.key, null, null, episode.title)}
                >
                  {episode.poster ? (
                    <img
                      class="h-[90px] w-16 shrink-0 rounded-sm object-cover"
                      src={episode.poster}
                      alt=""
                      width="64"
                      height="90"
                      loading="lazy"
                    />
                  ) : (
                    <span class="h-[90px] w-16 shrink-0 rounded-sm bg-skeleton" />
                  )}
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-ui font-medium">{episode.title}</span>
                    <span class="mt-0.5 block truncate text-caption text-faint">{episode.label}</span>
                  </span>
                  {episode.time && (
                    <span class="shrink-0 self-center text-meta font-semibold text-accent">
                      {episode.time}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        ))}
      </>
    ) : (
      <>
        <div class="pb-3">
          <DayStrip />
        </div>
        <SkeletonList count={4} />
      </>
    )
  }
</div>
