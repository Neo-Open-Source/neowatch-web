---
interface Props {
  count?: number;
}

const { count = 6 } = Astro.props;
---

<ul class="flex flex-col" aria-hidden="true">
  {
    Array.from({ length: count }, () => (
      <li class="flex items-start gap-3 px-2 py-2">
        <span class="h-[90px] w-16 shrink-0 animate-pulse rounded-sm bg-skeleton" />
        <span class="min-w-0 flex-1">
          <span class="block h-3 w-2/3 animate-pulse rounded-sm bg-skeleton-strong" />
          <span class="mt-2 block h-2.5 w-1/3 animate-pulse rounded-sm bg-skeleton-strong" />
        </span>
        <span class="ml-auto h-3 w-10 shrink-0 self-center animate-pulse rounded-sm bg-skeleton-strong" />
      </li>
    ))
  }
</ul>
