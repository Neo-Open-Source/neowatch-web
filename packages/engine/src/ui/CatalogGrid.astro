---
import { mockRatings } from "../data/mock-ratings";
import type { PosterItem } from "../lib/poster-item";
import CatalogRow from "./CatalogRow.astro";
import PosterCard from "./PosterCard.astro";
import SkeletonCard from "./SkeletonCard.astro";

interface Props {
  cards?: PosterItem[];
  ranked?: boolean;
  favorites?: Set<string>;
}

const { cards = [], ranked = false, favorites = new Set<string>() } = Astro.props;
const rankAt = (index: number): number | undefined => (ranked ? index + 1 : undefined);
const placeholders = Array.from({ length: 30 }, (_, index) => index);
---

<ol class="grid grid-cols-[repeat(auto-fill,minmax(165px,1fr))] gap-x-3 gap-y-5 pt-1" data-view-grid>
  {
    cards.length > 0
      ? cards.map((card, index) => (
          <PosterCard card={card} favorite={favorites.has(card.key)} rank={rankAt(index)} />
        ))
      : placeholders.map((index) => <SkeletonCard rank={rankAt(index)} rating={mockRatings[index]} />)
  }
</ol>

<ul class="hidden flex-col pt-2" data-view-list>
  {
    cards.length > 0 ? (
      cards.map((card, index) => <CatalogRow card={card} rank={rankAt(index)} />)
    ) : (
      placeholders.slice(0, 8).map(() => (
        <li class="flex gap-4 px-1 py-4">
          <span class="h-[154px] w-[110px] shrink-0 animate-pulse rounded-poster bg-skeleton sm:h-[210px] sm:w-[150px]" />
          <span class="flex min-w-0 flex-1 flex-col">
            <span class="h-[18px] w-1/2 animate-pulse rounded-sm bg-skeleton-strong" />
            <span class="mt-2 h-3 w-1/3 animate-pulse rounded-sm bg-skeleton-strong" />
            <span class="mt-3 h-3 w-16 animate-pulse rounded-sm bg-skeleton-strong" />
            <span class="mt-3.5 h-3 w-full animate-pulse rounded-sm bg-skeleton-strong" />
            <span class="mt-2 h-3 w-4/5 animate-pulse rounded-sm bg-skeleton-strong" />
          </span>
        </li>
      ))
    )
  }
</ul>
