---
import { Icon } from "astro-icon/components";
import { text } from "../../lib/text";
---

<div
  class="absolute top-3 right-3 flex items-center gap-0.5 rounded-md border border-line bg-elevated p-1 shadow-panel sm:top-4 sm:right-4"
>
  <button
    class="grid size-9 place-items-center rounded-sm text-muted transition-colors hover:bg-surface-hover hover:text-ink"
    type="button"
    aria-label={text.watch.align}
    data-watch-align
  >
    <Icon name="solar:double-alt-arrow-up-linear" width="18" height="18" />
  </button>
  <button
    class="grid size-9 place-items-center rounded-sm text-muted transition-colors hover:bg-surface-hover hover:text-ink"
    type="button"
    aria-label={text.watch.hidePanel}
    aria-pressed="true"
    data-watch-panel-toggle
  >
    <span
      data-watch-panel-chevron
      class="transition-[rotate] duration-[var(--nw-duration-base)] ease-[var(--nw-ease)] data-[panel=hidden]:rotate-180"
    >
      <Icon name="solar:alt-arrow-right-linear" width="20" height="20" />
    </span>
  </button>
</div>
