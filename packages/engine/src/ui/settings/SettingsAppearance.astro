---
import { Icon } from "astro-icon/components";
import { text } from "../../lib/text";

const modes = [
  { id: "system", icon: "solar:monitor-bold", label: text.theme.system },
  { id: "light", icon: "solar:sun-bold", label: text.theme.light },
  { id: "dark", icon: "solar:moon-bold", label: text.theme.dark },
] as const;
---

<section class="rounded-md bg-elevated p-4" aria-label={text.settings.appearance} data-settings-appearance>
  <h2 class="pb-4 text-heading font-semibold text-ink">{text.settings.appearance}</h2>

  <div class="flex flex-col gap-2">
    <p class="text-ui font-medium text-muted">{text.settings.theme}</p>
    <div class="flex flex-wrap gap-2">
      {
        modes.map((mode) => (
          <button
            class="flex h-11 items-center gap-2 rounded-sm px-3 text-ui font-medium text-muted transition-colors hover:bg-surface-hover hover:text-ink aria-pressed:bg-surface aria-pressed:font-semibold aria-pressed:text-ink"
            type="button"
            aria-pressed={mode.id === "system"}
            data-theme-mode={mode.id}
          >
            <Icon name={mode.icon} width="18" height="18" class="shrink-0" />
            {mode.label}
          </button>
        ))
      }
    </div>
  </div>
</section>
