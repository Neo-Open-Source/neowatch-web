---
import { Icon } from "astro-icon/components";
import type { PosterItem } from "../lib/poster-item";
import { mediaUrl } from "../lib/media-url";
import { text } from "../lib/text";

interface Props {
  items: PosterItem[] | null;
  limit?: number;
}

const { items, limit = 8 } = Astro.props;
---

{
  items ? (
    <ol class="flex flex-col">
      {items.slice(0, limit).map((item, index) => (
        <li>
          <a
            class="flex gap-4 rounded-md px-2 py-3 transition-colors hover:bg-surface-hover"
            href={mediaUrl(item.key, item.titleEnglish, item.titleOriginal, item.title)}
          >
            <span class="w-6 shrink-0 pt-1 text-right text-base font-bold text-accent">{index + 1}</span>
            {item.poster ? (
              <img
                class="h-[224px] w-[160px] shrink-0 rounded-poster object-cover"
                src={item.poster}
                alt=""
                width="160"
                height="224"
                loading="lazy"
              />
            ) : (
              <span class="h-[224px] w-[160px] shrink-0 rounded-poster bg-skeleton" />
            )}
            <span class="flex min-w-0 flex-1 flex-col">
              <span class="line-clamp-1 text-base font-semibold">{item.title}</span>
              <span class="mt-1 flex items-center gap-2.5 text-caption text-faint">
                <span>
                  {text.kinds[item.kind]}
                  {item.year ? ` · ${item.year}` : ""}
                </span>
                {item.rating > 0 && (
                  <span class="inline-flex items-center gap-1 font-semibold text-muted">
                    <Icon name="solar:star-bold" width="12" height="12" class="text-accent" />
                    {item.rating.toFixed(1)}
                  </span>
                )}
                {item.ageRating && (
                  <span class="rounded-sm border border-accent/60 px-1.5 py-0.5 text-micro font-semibold text-accent">
                    {item.ageRating}
                  </span>
                )}
              </span>
              {item.description && (
                <p class="mt-2 line-clamp-3 text-meta leading-[1.45] text-muted">{item.description}</p>
              )}
            </span>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <ul class="flex flex-col" aria-hidden="true">
      {Array.from({ length: 4 }, () => (
        <li class="flex gap-4 px-2 py-3">
          <span class="h-[224px] w-[160px] shrink-0 animate-pulse rounded-poster bg-skeleton" />
          <span class="flex min-w-0 flex-1 flex-col">
            <span class="h-4 w-3/5 animate-pulse rounded-sm bg-skeleton" />
            <span class="mt-2 h-3 w-28 animate-pulse rounded-sm bg-skeleton" />
            <span class="mt-3 h-3 w-full animate-pulse rounded-sm bg-skeleton" />
            <span class="mt-2 h-3 w-full animate-pulse rounded-sm bg-skeleton" />
            <span class="mt-2 h-3 w-3/4 animate-pulse rounded-sm bg-skeleton" />
          </span>
        </li>
      ))}
    </ul>
  )
}
