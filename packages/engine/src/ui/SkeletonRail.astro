---
import Carousel from "./Carousel.astro";

interface Props {
  count?: number;
  backdrop?: boolean;
}

const { count = 24, backdrop = false } = Astro.props;
---

<Carousel aria-hidden wide={backdrop}>
  {
    Array.from({ length: count }, () =>
      backdrop ? (
        <li>
          <div class="overflow-hidden rounded-poster bg-bg">
            <div class="relative aspect-video w-full animate-pulse bg-skeleton">
              <span class="absolute bottom-2 left-2 h-3 w-16 rounded-sm bg-skeleton-strong" />
              <span class="absolute bottom-2 right-2 h-3 w-20 rounded-sm bg-skeleton-strong" />
            </div>
            <div class="h-1 w-full bg-accent" />
            <div class="px-2.5 py-2">
              <div class="h-3 w-2/3 animate-pulse rounded-sm bg-skeleton-strong" />
            </div>
          </div>
        </li>
      ) : (
        <li>
          <div class="aspect-[5/7] w-full animate-pulse rounded-poster bg-skeleton" />
          <div class="mt-2 h-3.5 w-4/5 animate-pulse rounded-sm bg-skeleton-strong" />
          <div class="mt-1.5 h-3 w-1/2 animate-pulse rounded-sm bg-skeleton-strong" />
        </li>
      ),
    )
  }
</Carousel>
